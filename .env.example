# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Credentials (found in Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin API Key — sent as x-admin-key header from the admin portal frontend.
# Must be a strong, randomly generated secret. Never commit the real value.
ADMIN_API_KEY=your_admin_api_key_here

# GOD (Super Admin) API Key — sent as x-god-key header.
# Must be a strong, randomly generated secret. Never commit the real value.
GOD_API_KEY=your_god_api_key_here

# Session token expiry in minutes (default: 30)
SESSION_TTL_MINUTES=30
