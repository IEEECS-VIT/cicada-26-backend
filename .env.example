# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Credentials (found in Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# ANON KEY — used to verify regular USER Supabase JWTs (respects Row Level Security)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SERVICE ROLE KEY — used to verify ADMIN/GOD Supabase JWTs + all DB operations (bypasses RLS)
# NEVER expose this key to the frontend or public. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin API Key — sent as x-admin-key header from the admin portal frontend
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your_strong_admin_api_key_here

# GOD (Super Admin) API Key — sent as x-god-key header
# Generate with: openssl rand -hex 32
GOD_API_KEY=your_strong_god_api_key_here

# Session token expiry in minutes (default: 30)
SESSION_TTL_MINUTES=30

# Allowed CORS origin — your frontend domain (no trailing slash)
# Example: https://cicada-2067.vercel.app
CORS_ORIGIN=http://localhost:5173
