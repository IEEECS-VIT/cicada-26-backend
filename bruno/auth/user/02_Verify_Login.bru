meta {
  name: 02_Verify_Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-login
  body: json
  auth: none
}

body:json {
  {
    "email": "shikhar102005@gmail.com",
    "google_display_name": "Shikhar"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {
    if (res.body.admin_secret_key) {
      bru.setEnvVar("adminKey", res.body.admin_secret_key);
    } else {
      bru.setEnvVar("adminKey", "");
    }
    if (res.body.user && res.body.user.email) {
      bru.setEnvVar("userEmail", res.body.user.email);
    }
  }
}
